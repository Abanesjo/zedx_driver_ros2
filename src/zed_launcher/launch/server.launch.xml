<launch>
  <!--
    camera_type selects the camera family and is passed to the ZED wrapper as its
    camera_model. Valid grab_resolution / grab_frame_rate combinations (resolution
    is per eye):

      zedx  (ZED X, GMSL2)
        HD1200  1920x1200   60, 30, 15 fps
        HD1080  1920x1080   60, 30, 15 fps
        SVGA     960x600   120, 60, 30, 15 fps

      zedm  (ZED Mini, USB 3)
        HD2K    2208x1242   15 fps
        HD1080  1920x1080   30, 15 fps
        HD720   1280x720    60, 30, 15 fps
        VGA      672x376   100, 60, 30, 15 fps

    An unsupported frame rate is not an error: the SDK replaces it with a valid
    one and the wrapper only logs a warning.

    Defaults: zedx streams HD1080 at 60 fps. zedm streams VGA at 100 fps, because
    on the Jetson AGX Thor a ZED Mini at HD720 only reaches 25 to 45 Hz of body
    tracking, while VGA keeps the fused skeleton at 60 Hz.

    num_cameras is 1 or 2. With 1 only the left camera is started. Its default
    follows the current rigs: two ZED X, one ZED Mini.
  -->
  <arg name="camera_type" default="zedx" description="Camera family: zedx (GMSL2) or zedm (USB)">
    <choice value="zedx" />
    <choice value="zedm" />
  </arg>

  <arg
    name="num_cameras"
    default="$(eval '\'2\' if \'$(var camera_type)\' == \'zedx\' else \'1\'')"
    description="Number of cameras to start: 1 (left only) or 2"
  >
    <choice value="1" />
    <choice value="2" />
  </arg>

  <arg
    name="grab_resolution"
    default="$(eval '\'HD1080\' if \'$(var camera_type)\' == \'zedx\' else \'VGA\'')"
  />
  <arg
    name="grab_frame_rate"
    default="$(eval '\'60\' if \'$(var camera_type)\' == \'zedx\' else \'100\'')"
  />
  <arg name="stream_target_framerate" default="0" />

  <arg name="left_camera_name" default="zed_left" />
  <arg name="right_camera_name" default="zed_right" />
  <arg name="left_camera_id" default="0" />
  <arg name="right_camera_id" default="1" />
  <!-- A serial greater than 0 takes precedence over the camera ID. USB camera IDs
       follow enumeration order, so set the serials for zedm. -->
  <arg name="left_serial" default="0" />
  <arg name="right_serial" default="0" />
  <arg name="left_stream_port" default="30000" />
  <arg name="right_stream_port" default="30002" />
  <arg name="stream_codec" default="H264" />
  <arg name="stream_bitrate" default="7000" />

  <!-- Stream server only: every other wrapper feature is turned off. -->
  <let
    name="common_overrides"
    value="stream_server.stream_enabled:=true;stream_server.codec:=$(var stream_codec);stream_server.bitrate:=$(var stream_bitrate);stream_server.target_framerate:=$(var stream_target_framerate);general.grab_resolution:=$(var grab_resolution);general.grab_frame_rate:=$(var grab_frame_rate);general.publish_status:=false;video.publish_rgb:=false;video.publish_left_right:=false;video.publish_raw:=false;video.publish_gray:=false;video.publish_stereo:=false;sensors.publish_imu:=false;sensors.publish_imu_raw:=false;sensors.publish_cam_imu_transf:=false;sensors.publish_mag:=false;sensors.publish_baro:=false;sensors.publish_temp:=false;region_of_interest.publish_roi_mask:=false;depth.depth_mode:=NONE;depth.publish_depth_map:=false;depth.publish_depth_info:=false;depth.publish_point_cloud:=false;depth.publish_depth_confidence:=false;depth.publish_disparity:=false;pos_tracking.pos_tracking_enabled:=false;pos_tracking.publish_odom_pose:=false;pos_tracking.publish_pose_cov:=false;pos_tracking.publish_cam_path:=false;object_detection.od_enabled:=false;body_tracking.bt_enabled:=false;mapping.mapping_enabled:=false;mapping.publish_det_plane:=false"
  />

  <include file="$(find-pkg-share zed_wrapper)/launch/zed_camera.launch.py">
    <arg name="camera_model" value="$(var camera_type)" />
    <arg name="camera_name" value="$(var left_camera_name)" />
    <arg name="camera_id" value="$(var left_camera_id)" />
    <arg name="serial_number" value="$(var left_serial)" />
    <arg name="publish_urdf" value="false" />
    <arg name="publish_tf" value="false" />
    <arg name="publish_map_tf" value="false" />
    <arg name="publish_imu_tf" value="false" />

    <arg
      name="param_overrides"
      value="stream_server.port:=$(var left_stream_port);$(var common_overrides)"
    />
  </include>

  <group if="$(eval '$(var num_cameras) == 2')">
    <include file="$(find-pkg-share zed_wrapper)/launch/zed_camera.launch.py">
      <arg name="camera_model" value="$(var camera_type)" />
      <arg name="camera_name" value="$(var right_camera_name)" />
      <arg name="camera_id" value="$(var right_camera_id)" />
      <arg name="serial_number" value="$(var right_serial)" />
      <arg name="publish_urdf" value="false" />
      <arg name="publish_tf" value="false" />
      <arg name="publish_map_tf" value="false" />
      <arg name="publish_imu_tf" value="false" />

      <arg
        name="param_overrides"
        value="stream_server.port:=$(var right_stream_port);$(var common_overrides)"
      />
    </include>
  </group>
</launch>
