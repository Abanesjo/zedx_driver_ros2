<launch>
  <arg name="debug" default="false" />
  <arg name="camera_fps" default="60" />
  <arg name="fusion_publish_rate_hz" default="60.0" />

  <arg name="role" default="local" />
  <arg name="input_mode" default="stream" />
  <arg name="stream_address" default="$(env ZED_BOX_IP 127.0.0.1)" />
  <arg
    name="camera_names"
    default="['zed_left', 'zed_center', 'zed_right']"
  />
  <arg
    name="camera_serials"
    default="[41235597, 46229474, 49967328]"
  />
  <arg name="stream_ports" default="[30000, 30004, 30002]" />
  <arg
    name="fusion_config_path"
    default="$(find-pkg-share zed_launcher)/calibration/calibration.json"
  />
  <!-- Options: HUMAN_BODY_FAST, HUMAN_BODY_MEDIUM, HUMAN_BODY_ACCURATE -->
  <arg name="body_model" default="HUMAN_BODY_FAST" />
  <!-- Options: BODY_18, BODY_34, BODY_38 -->
  <arg name="body_format" default="BODY_38" />
  <!-- confidence threshold for body tracking -->
  <arg name="confidence_threshold" default="70.0" />
  <!-- to publish only one skeleton -->
  <arg name="single_body_enabled" default="true" />
  <!-- when switching from one skeleton to another, the confidence difference must be greater than the margin -->
  <arg name="single_body_switch_margin" default="10.0" />
  <!-- confidence must be greater for X frames -->
  <arg name="single_body_switch_frames" default="60" />
  <arg name="publish_frame_id" default="fusion_world" />
  <arg name="output_topic" default="body_trk/skeletons" />
  <arg name="camera_resolution" default="HD1080" />
  <arg name="enable_apriltag_fusion" default="true" />
  <arg name="publish_images" default="$(var enable_apriltag_fusion)" />
  <arg name="publish_overlay_images" default="$(var debug)" />
  <arg name="publish_per_camera_skeletons" default="$(var debug)" />
  <arg name="overlay_min_confidence" default="$(var confidence_threshold)" />
  <arg name="overlay_max_skeleton_age_sec" default="0.5" />
  <arg name="apriltag_target_id" default="0" />
  <arg name="apriltag_size_m" default="0.06" />
  <arg name="apriltag_tag_frame_id" default="apriltag_0" />
  <arg
    name="apriltag_pose_topic"
    default="/fusion_world_pose_in_apriltag"
  />
  <arg name="apriltag_publish_fusion_pose" default="true" />
  <arg name="apriltag_publish_tf" default="true" />
  <arg name="apriltag_max_detection_rate_hz" default="30.0" />
  <arg name="apriltag_fusion_publish_rate_hz" default="30.0" />
  <arg name="apriltag_max_observation_age_sec" default="0.15" />
  <arg name="apriltag_sync_tolerance_sec" default="0.05" />
  <arg name="apriltag_min_marker_area_px2" default="64.0" />
  <arg name="apriltag_max_reprojection_rmse_px" default="3.0" />
  <arg name="apriltag_max_translation_disagreement_m" default="0.25" />
  <arg name="apriltag_max_rotation_disagreement_deg" default="25.0" />
  <arg name="apriltag_smoothing_time_constant_sec" default="0.10" />
  <arg name="apriltag_smoothing_reset_sec" default="0.5" />
  <arg name="apriltag_dictionary" default="APRILTAG_36h11" />
  <arg name="apriltag_corner_refinement" default="true" />
  <arg name="apriltag_camera_frame_convention" default="zed_x_forward" />
  <!-- Options: PERFORMANCE, QUALITY, ULTRA, NEURAL_LIGHT, NEURAL, NEURAL_PLUS -->
  <arg name="depth_mode" default="NEURAL_LIGHT" />
  <arg name="fusion_reference_frame" default="WORLD" />
  <arg name="fusion_skeleton_smoothing" default="1.0" />
  <arg name="fusion_minimum_allowed_cameras" default="2" />
  <arg name="fusion_minimum_allowed_keypoints" default="7" />
  <arg name="sender_tracking_enabled" default="true"/>
  <arg name="fusion_tracking_enabled" default="true"/>
  <arg name="body_fitting_enabled" default="true" />
  <arg name="set_as_static" default="true" />
  <arg name="allow_reduced_precision_inference" default="false" />
  <arg name="sdk_gpu_id" default="-1" />
  <arg name="sdk_verbose" default="1" />
  <arg name="rviz" default="false" />
  <arg
    name="rviz_config"
    default="$(find-pkg-share zed_launcher)/rviz/body_fusion.rviz"
  />

  <node
    pkg="zed_launcher"
    exec="zed_body_fusion_node"
    namespace="zed_fusion"
    name="zed_body_fusion_node"
    output="screen"
  >
    <param name="role" value="$(var role)" />
    <param name="input_mode" value="$(var input_mode)" />
    <param name="stream_address" value="$(var stream_address)" />
    <param name="camera_names" value="$(var camera_names)" />
    <param name="camera_serials" value="$(var camera_serials)" />
    <param name="stream_ports" value="$(var stream_ports)" />
    <param name="fusion_config_path" value="$(var fusion_config_path)" />
    <param name="body_model" value="$(var body_model)" />
    <param name="body_format" value="$(var body_format)" />
    <param name="confidence_threshold" value="$(var confidence_threshold)" />
    <param name="single_body_enabled" value="$(var single_body_enabled)" />
    <param name="single_body_switch_margin" value="$(var single_body_switch_margin)" />
    <param name="single_body_switch_frames" value="$(var single_body_switch_frames)" />
    <param name="publish_frame_id" value="$(var publish_frame_id)" />
    <param name="output_topic" value="$(var output_topic)" />
    <param name="camera_resolution" value="$(var camera_resolution)" />
    <param name="camera_fps" value="$(var camera_fps)" />
    <param name="publish_images" value="$(var publish_images)" />
    <param name="publish_overlay_images" value="$(var publish_overlay_images)" />
    <param name="publish_per_camera_skeletons" value="$(var publish_per_camera_skeletons)" />
    <param name="overlay_min_confidence" value="$(var overlay_min_confidence)" />
    <param name="overlay_max_skeleton_age_sec" value="$(var overlay_max_skeleton_age_sec)" />
    <param name="depth_mode" value="$(var depth_mode)" />
    <param name="fusion_reference_frame" value="$(var fusion_reference_frame)" />
    <param name="fusion_publish_rate_hz" value="$(var fusion_publish_rate_hz)" />
    <param name="fusion_skeleton_smoothing" value="$(var fusion_skeleton_smoothing)" />
    <param name="fusion_minimum_allowed_cameras" value="$(var fusion_minimum_allowed_cameras)" />
    <param name="fusion_minimum_allowed_keypoints" value="$(var fusion_minimum_allowed_keypoints)" />
    <param name="sender_tracking_enabled" value="$(var sender_tracking_enabled)" />
    <param name="fusion_tracking_enabled" value="$(var fusion_tracking_enabled)" />
    <param name="body_fitting_enabled" value="$(var body_fitting_enabled)" />
    <param name="set_as_static" value="$(var set_as_static)" />
    <param
      name="allow_reduced_precision_inference"
      value="$(var allow_reduced_precision_inference)"
    />
    <param name="sdk_gpu_id" value="$(var sdk_gpu_id)" />
    <param name="sdk_verbose" value="$(var sdk_verbose)" />
  </node>

  <node
    if="$(var enable_apriltag_fusion)"
    pkg="zed_launcher"
    exec="apriltag_fusion_node"
    name="apriltag_fusion_node"
    output="screen"
  >
    <param name="camera_names" value="$(var camera_names)" />
    <param name="fusion_frame_id" value="$(var publish_frame_id)" />
    <param name="target_tag_id" value="$(var apriltag_target_id)" />
    <param name="tag_size_m" value="$(var apriltag_size_m)" />
    <param name="tag_frame_id" value="$(var apriltag_tag_frame_id)" />
    <param name="pose_topic" value="$(var apriltag_pose_topic)" />
    <param
      name="publish_fusion_pose"
      value="$(var apriltag_publish_fusion_pose)"
    />
    <param name="publish_tf" value="$(var apriltag_publish_tf)" />
    <param
      name="max_detection_rate_hz"
      value="$(var apriltag_max_detection_rate_hz)"
    />
    <param
      name="fusion_publish_rate_hz"
      value="$(var apriltag_fusion_publish_rate_hz)"
    />
    <param
      name="max_observation_age_sec"
      value="$(var apriltag_max_observation_age_sec)"
    />
    <param
      name="sync_tolerance_sec"
      value="$(var apriltag_sync_tolerance_sec)"
    />
    <param
      name="min_marker_area_px2"
      value="$(var apriltag_min_marker_area_px2)"
    />
    <param
      name="max_reprojection_rmse_px"
      value="$(var apriltag_max_reprojection_rmse_px)"
    />
    <param
      name="max_translation_disagreement_m"
      value="$(var apriltag_max_translation_disagreement_m)"
    />
    <param
      name="max_rotation_disagreement_deg"
      value="$(var apriltag_max_rotation_disagreement_deg)"
    />
    <param
      name="smoothing_time_constant_sec"
      value="$(var apriltag_smoothing_time_constant_sec)"
    />
    <param
      name="smoothing_reset_sec"
      value="$(var apriltag_smoothing_reset_sec)"
    />
    <param name="dictionary" value="$(var apriltag_dictionary)" />
    <param
      name="corner_refinement"
      value="$(var apriltag_corner_refinement)"
    />
    <param
      name="camera_frame_convention"
      value="$(var apriltag_camera_frame_convention)"
    />
  </node>

  <node
    if="$(var rviz)"
    pkg="rviz2"
    exec="rviz2"
    name="rviz2"
    output="screen"
    args="-d $(var rviz_config)"
  />
</launch>
